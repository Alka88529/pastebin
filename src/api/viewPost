const express = require('express');
const path = require('path');
const router = express.Router();
const { db } = require('../db');
const fs = require('fs');
const { getCurrentTimestamp } = require('../utils/utils');


// Route to fetch paste content and serve HTML
router.get('/p/:id', async (req, res) => {
    const pasteId = req.params.id;
    const query = 'SELECT * FROM posts WHERE id = $1';
    const updateQuery = 'UPDATE posts SET max_views = max_views - 1 WHERE id = $1 AND max_views IS NOT NULL AND max_views > 0'; 

    try {
        const result = await db.query(query, [pasteId]);
        const rows = result.rows;
        console.log('Rows fetched:', rows);
        if (rows.length === 0) {
            return res.status(404).send('Post not found');
        }
        if (rows[0].max_views == 0) {
            return res.status(404).send('Paste has expired due to max views reached');
        }
        const expires_at = rows[0].ttl_seconds ? getCurrentTimestamp(req) + rows[0].ttl_seconds * 1000 : null;
        const now = new Date();
        console.log('Expires at:', expires_at);
        console.log('Current time:', now);
        console.log("expires_at > now:", expires_at < now);
        if (rows[0].ttl_seconds != null && now > new Date(expires_at)) {
            return res.status(404).send('Post has expired');
        }
        const updatedData = await db.query(updateQuery, [pasteId]);
        const content = rows[0].content;        
        const filePath = path.join(__dirname, '../view/post_view.html');
        fs.readFile(filePath, 'utf8', (err, html) => {
            if (err) {
                console.error('Error reading HTML file:', err);
                return res.status(500).send('Error loading page');
            }

            // Replace the placeholder with the content
            const modifiedHtml = html.replace('{{content}}', content);

            // Send the modified HTML
            res.send(modifiedHtml);
        });
    } catch (error) {
        console.error('Error fetching paste:', error);
        res.status(500).send('Failed to fetch paste '+error);
    }
});

module.exports = router;